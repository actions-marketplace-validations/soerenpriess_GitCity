{
  "name": "git-city",
  "version": "0.1.0",
  "packageManager": "pnpm@9.12.0",
  "description": "Turn public GitHub activity into a deterministic animated pixel city.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "git-city": "dist/src/cli.js"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -p tsconfig.json && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "examples:showcase": "tsx scripts/generate-showcase.ts",
    "examples:readme": "tsx scripts/generate-readme.ts",
    "format": "prettier --write .",
    "lint": "eslint ."
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.80",
    "gifenc": "^1.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@types/node": "^22.15.30",
    "eslint": "^9.28.0",
    "prettier": "^3.5.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.34.0",
    "vite": "^6.3.5",
    "vitest": "^3.2.3"
  }
}
